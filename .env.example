# Mattermost 서버 (2장에서 설치한 주소)
MM_URL=http://localhost:8065
MM_WS_URL=ws://localhost:8065/api/v4/websocket

# 봇 계정 토큰 (7-1절에서 발급)
MM_BOT_TOKEN=

# Incoming Webhook URL (5-1절에서 발급)
MM_WEBHOOK_URL=

# Outgoing Webhook 토큰 (5-3절에서 발급)
MM_OUTGOING_TOKEN=

# 슬래시 커맨드 토큰 (6-1절에서 발급)
MM_SLASH_TOKEN=

# 팀/채널 URL 이름 (7장 예제에서 사용)
MM_TEAM=ourcompany
MM_CHANNEL=alerts

# OpenAI (8-4, 9-3절)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 일일 리포트 봇 (9-2절)
REPORT_REPO=mattermost/mattermost
GITHUB_TOKEN=
